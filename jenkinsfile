
pipeline {
    agent {
        label 'jenkins_agent'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)

        buildDiscarder(logRotator(
            numToKeepStr: '10',
            artifactNumToKeepStr: '5'
        ))
    }

    environment {
        // GitHub
        GIT_URL             = 'https://github.com/cloudvivek/DevOps-Project-Zomato-Kastro.git'
        GIT_BRANCH          = 'master'

        // SonarQube
        SONAR_URL           = 'http://13.201.125.122:9000'
        SONAR_PROJECT       = 'zomato-kastro'

        // Dependency-Track
        DT_URL              = 'http://13.201.125.122:8087'
        DT_PROJECT_NAME     = 'DevOps-Project-Zomato-Kastro'
        DT_PROJECT_VERSION  = 'master'

        // Docker Hub
        DOCKER_IMAGE        = 'teqvivek123/zomato-kastro'

        // Reports and AI
        REPORT_DIR          = 'security-reports'
        BUILD_LOG           = 'build_output.log'
    }

    stages {

        // --------------------------------------------------
        // 1. CHECKOUT
        // --------------------------------------------------
        stage('Checkout') {
            steps {
                sh '''
                    #!/bin/bash
                    set -Eeuo pipefail

                    mkdir -p "$WORKSPACE"
                    : > "$WORKSPACE/$BUILD_LOG"

                    echo "Build log initialized."
                '''

                git branch: "${GIT_BRANCH}",
                    url: "${GIT_URL}"

                sh '''
                    #!/bin/bash
                    set -Eeuo pipefail

                    exec > >(tee -a "$WORKSPACE/$BUILD_LOG") 2>&1

                    echo "======================================"
                    echo "GitHub Checkout Successful"
                    echo "======================================"

                    git log -1 --oneline

                    echo "Repository: $GIT_URL"
                    echo "Branch: $GIT_BRANCH"

                    mkdir -p "$REPORT_DIR"

                    test -f package.json
                    test -f Dockerfile
                    test -f self_heal.sh

                    echo "Required files verified."
                '''
            }
        }

        // --------------------------------------------------
        // 2. GITLEAKS SECRET SCAN
        // --------------------------------------------------
        stage('Gitleaks Secret Scan') {
            steps {
                sh '''
                    #!/bin/bash
                    set -Eeuo pipefail

                    exec > >(tee -a "$WORKSPACE/$BUILD_LOG") 2>&1

                    set +e

                    mkdir -p "$REPORT_DIR"
                    rm -f "$REPORT_DIR/gitleaks-report.json"

                    echo "===== Gitleaks Secret Scan ====="

                    docker run --rm \
                        --user "$(id -u):$(id -g)" \
                        -v "$WORKSPACE:/repo" \
                        -w /repo \
                        zricethezav/gitleaks:latest \
                        detect \
                        --no-git \
                        --source=/repo \
                        --report-format=json \
                        --report-path=/repo/security-reports/gitleaks-report.json \
                        --redact \
                        --exit-code=0 \
                        --ignore-path=security-reports

                    RC=$?

                    if [ ! -f "$REPORT_DIR/gitleaks-report.json" ]; then
                        echo "[]" > "$REPORT_DIR/gitleaks-report.json"
                        echo "Gitleaks did not create a report." \
                            > "$REPORT_DIR/gitleaks-error.txt"
                    fi

                    echo "Gitleaks execution exit code: $RC"

                    python3 -c '
import json
with open("security-reports/gitleaks-report.json") as f:
    findings = json.load(f)
print("Total Gitleaks findings:", len(findings))
for item in findings:
    print("Rule:", item.get("RuleID"),
          "| File:", item.get("File"),
          "| Line:", item.get("StartLine"))
'

                    if [ "$RC" -ne 0 ]; then
                        echo "Gitleaks execution failed." \
                            > "$REPORT_DIR/gitleaks-error.txt"
                    fi

                    echo "Gitleaks scan completed."
                    exit 0
                '''
            }
        }

        // --------------------------------------------------
        // 3. TRIVY FILESYSTEM SCAN
        // --------------------------------------------------
        stage('Trivy Filesystem Scan') {
            steps {
                sh '''
                    #!/bin/bash
                    set -Eeuo pipefail

                    exec > >(tee -a "$WORKSPACE/$BUILD_LOG") 2>&1

                    set +e

                    mkdir -p "$REPORT_DIR"
                    rm -f "$REPORT_DIR/trivy-report.json"
                    rm -f "$REPORT_DIR/trivy-report.txt"

                    echo "===== Trivy JSON Scan ====="

                    docker run --rm \
                        --user "$(id -u):$(id -g)" \
                        -e HOME=/tmp \
                        -v "$WORKSPACE:/path" \
                        aquasec/trivy:latest \
                        fs \
                        --cache-dir /tmp/trivy-cache \
                        --scanners vuln,misconfig,secret \
                        --severity UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL \
                        --skip-dirs /path/node_modules \
                        --skip-dirs /path/.git \
                        --skip-dirs /path/security-reports \
                        --format json \
                        --output /path/security-reports/trivy-report.json \
                        --exit-code 0 \
                        /path

                    JSON_RC=$?

                    echo "===== Trivy Table Scan ====="

                    docker run --rm \
                        --user "$(id -u):$(id -g)" \
                        -e HOME=/tmp \
                        -v "$WORKSPACE:/path" \
                        aquasec/trivy:latest \
                        fs \
                        --cache-dir /tmp/trivy-cache \
                        --scanners vuln,misconfig,secret \
                        --severity UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL \
                        --skip-dirs /path/node_modules \
                        --skip-dirs /path/.git \
                        --skip-dirs /path/security-reports \
                        --format table \
                        --output /path/security-reports/trivy-report.txt \
                        --exit-code 0 \
                        /path

                    TABLE_RC=$?

                    echo "Trivy JSON exit code: $JSON_RC"
                    echo "Trivy table exit code: $TABLE_RC"

                    if [ "$JSON_RC" -ne 0 ] || [ "$TABLE_RC" -ne 0 ]; then
                        echo "Trivy execution failed." \
                            > "$REPORT_DIR/trivy-scan-error.txt"
                    fi

                    if [ -f "$REPORT_DIR/trivy-report.txt" ]; then
                        cat "$REPORT_DIR/trivy-report.txt"
                    fi

                    echo "Trivy scan completed."
                    exit 0
                '''
            }
        }

        // --------------------------------------------------
        // 4. SONARQUBE ANALYSIS
        // --------------------------------------------------
        stage('SonarQube Scan') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'sonar-token',
                        variable: 'SONAR_TOKEN'
                    )
                ]) {
                    sh '''
                        #!/bin/bash
                        set -Eeuo pipefail

                        exec > >(tee -a "$WORKSPACE/$BUILD_LOG") 2>&1

                        echo "===== SonarQube Analysis ====="

                        docker run --rm \
                            --user "$(id -u):$(id -g)" \
                            -e HOME=/tmp \
                            -v "$WORKSPACE:/usr/src" \
                            -w /usr/src \
                            -e SONAR_HOST_URL="$SONAR_URL" \
                            -e SONAR_TOKEN="$SONAR_TOKEN" \
                            sonarsource/sonar-scanner-cli:latest \
                            -Dsonar.projectKey="$SONAR_PROJECT" \
                            -Dsonar.projectName="Zomato Kastro" \
                            -Dsonar.sources=src \
                            -Dsonar.scm.provider=git \
                            -Dsonar.exclusions="node_modules/**,**/node_modules/**,**/dist/**,**/build/**,security-reports/**"

                        echo "SonarQube analysis submitted successfully."
                    '''
                }
            }
        }

        // --------------------------------------------------
        // 5. GENERATE SBOM
        // --------------------------------------------------
        stage('Generate SBOM') {
            steps {
                sh '''
                    #!/bin/bash
                    set -Eeuo pipefail

                    exec > >(tee -a "$WORKSPACE/$BUILD_LOG") 2>&1

                    mkdir -p "$REPORT_DIR"

                    echo "===== Generating CycloneDX SBOM ====="

                    docker run --rm \
                        --user "$(id -u):$(id -g)" \
                        -e HOME=/tmp \
                        -v "$WORKSPACE:/repo" \
                        aquasec/trivy:latest \
                        fs /repo \
                        --cache-dir /tmp/trivy-cache \
                        --skip-dirs /repo/.git \
                        --skip-dirs /repo/node_modules \
                        --skip-dirs /repo/security-reports \
                        --format cyclonedx \
                        --output /repo/security-reports/sbom.cdx.json

                    test -s "$REPORT_DIR/sbom.cdx.json"

                    echo "SBOM generated successfully."
                '''
            }
        }

        // --------------------------------------------------
        // 6. DEPENDENCY-TRACK UPLOAD
        // --------------------------------------------------
        stage('Upload SBOM to Dependency-Track') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'DT-token-k8s',
                        variable: 'DT_API_KEY'
                    )
                ]) {
                    sh '''
                        #!/bin/bash
                        set -Eeuo pipefail
                        set +x

                        exec > >(tee -a "$WORKSPACE/$BUILD_LOG") 2>&1

                        echo "===== Dependency-Track SBOM Upload ====="

                        curl --fail --silent --show-error \
                            --connect-timeout 15 \
                            --max-time 120 \
                            --request POST \
                            --url "$DT_URL/api/v1/bom" \
                            --header "X-Api-Key: $DT_API_KEY" \
                            --form "autoCreate=true" \
                            --form "projectName=$DT_PROJECT_NAME" \
                            --form "projectVersion=$DT_PROJECT_VERSION" \
                            --form "bom=@security-reports/sbom.cdx.json;type=application/json" \
                            --output "$REPORT_DIR/dt-upload-response.json"

                        echo "SBOM upload request accepted."
                        echo "Project: $DT_PROJECT_NAME"
                        echo "Version: $DT_PROJECT_VERSION"
                    '''
                }
            }
        }

        // --------------------------------------------------
        // 7. NODE.JS INSTALL & BUILD
        // --------------------------------------------------
        stage('Node.js Install and Build') {
            steps {
                sh '''
                    #!/bin/bash
                    set -Eeuo pipefail

                    exec > >(tee -a "$WORKSPACE/$BUILD_LOG") 2>&1

                    echo "===== Node.js Project Build ====="

                    test -f package.json

                    docker run --rm \
                        --user "$(id -u):$(id -g)" \
                        -e HOME=/tmp \
                        -e NPM_CONFIG_CACHE=/tmp/npm-cache \
                        -v "$WORKSPACE:/app" \
                        -w /app \
                        node:20-alpine \
                        sh -lc '
                            set -eu

                            echo "Node version:"
                            node --version

                            echo "NPM version:"
                            npm --version

                            echo "Installing dependencies..."
                            npm ci

                            if node -e "process.exit(require('./package.json').scripts?.build ? 0 : 1)"; then
                                echo "Build script found. Running npm run build."
                                npm run build
                            else
                                echo "No build script defined. Skipping build."
                            fi
                        '

                    echo "Node.js build completed."
                '''
            }
        }

        // --------------------------------------------------
        // 8. BUILD DOCKER IMAGE
        // --------------------------------------------------
        stage('Build Docker Image') {
            steps {
                sh '''
                    #!/bin/bash
                    set -Eeuo pipefail

                    exec > >(tee -a "$WORKSPACE/$BUILD_LOG") 2>&1

                    echo "===== Docker Image Build ====="

                    test -f Dockerfile

                    docker build \
                        --pull \
                        -t "$DOCKER_IMAGE:$BUILD_NUMBER" \
                        -t "$DOCKER_IMAGE:latest" \
                        .

                    echo "Docker image built successfully."

                    docker images "$DOCKER_IMAGE"
                '''
            }
        }

        // --------------------------------------------------
        // 9. PUSH IMAGE TO DOCKER HUB
        // --------------------------------------------------
        stage('Push Image to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-cred',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        #!/bin/bash
                        set -Eeuo pipefail
                        set +x

                        exec > >(tee -a "$WORKSPACE/$BUILD_LOG") 2>&1

                        echo "===== Docker Hub Login ====="

                        printf '%s' "$DOCKER_PASSWORD" |
                            docker login \
                                --username "$DOCKER_USER" \
                                --password-stdin

                        echo "===== Pushing Docker Images ====="

                        docker push "$DOCKER_IMAGE:$BUILD_NUMBER"
                        docker push "$DOCKER_IMAGE:latest"

                        echo "Images pushed successfully."

                        docker logout
                    '''
                }
            }
        }
    }

    // --------------------------------------------------
    // POST ACTIONS
    // --------------------------------------------------
    post {

        always {
            archiveArtifacts(
                artifacts: 'security-reports/**',
                allowEmptyArchive: true,
                fingerprint: true
            )

            echo 'Security reports and SBOM archive completed.'
            echo 'Pipeline execution completed.'
        }

        success {
            echo 'Pipeline completed successfully.'
            echo 'GitHub → Gitleaks → Trivy → SonarQube → SBOM → Dependency-Track → Node.js Build → Docker Build → Docker Hub Push'
        }

        failure {
            echo '🤖 Pipeline failed — invoking AI self-healing agent...'

            withCredentials([
                string(
                    credentialsId: 'github-token',
                    variable: 'GITHUB_TOKEN'
                )
            ]) {
                sh '''
                    #!/bin/bash

                    echo "======================================"
                    echo "SELF-HEALING AGENT"
                    echo "======================================"

                    if [ -s "$WORKSPACE/$BUILD_LOG" ] && [ -f self_heal.sh ]; then
                        bash ./self_heal.sh "$WORKSPACE/$BUILD_LOG" || {
                            echo "Self-healing encountered an issue."
                        }
                    else
                        echo "Build log or self_heal.sh is missing."
                        echo "AI self-healing cannot continue."
                    fi
                '''
            }
        }
    }
}
