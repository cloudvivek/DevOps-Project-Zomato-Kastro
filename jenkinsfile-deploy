
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(
            numToKeepStr: '10',
            artifactNumToKeepStr: '5'
        ))
    }

    environment {
        // GitHub
        GIT_URL = 'https://github.com/cloudvivek/DevOps-Project-Zomato-Kastro.git'
        GIT_BRANCH = 'master'

        // Docker Hub
        DOCKER_IMAGE = 'teqvivek123/zomato-kastro'

        // Kind Server
        KIND_SERVER = '15.252.121.248'
        SSH_CREDENTIAL_ID = 'kind-server-ssh'

        // Kubernetes configuration
        K8S_NAMESPACE = 'default'
        K8S_DEPLOYMENT = 'zomato'
        K8S_CONTAINER = 'zomato'

        // Additional namespace required by existing YAML
        K8S_EXTRA_NAMESPACE = 'prometheus-node-exporter'

        // Remote deployment directory
        REMOTE_BASE = '/tmp/zomato-kastro-deploy'
    }

    stages {

        // --------------------------------------------------
        // 1. CHECKOUT SOURCE CODE
        // --------------------------------------------------
        stage('Checkout') {
            steps {
                deleteDir()

                git branch: "${GIT_BRANCH}",
                    url: "${GIT_URL}"

                sh '''
                    set -eu

                    echo "===== GitHub Checkout Successful ====="

                    echo "Repository:"
                    git remote -v

                    echo "Current Branch:"
                    git branch --show-current

                    echo "Latest Commit:"
                    git log -1 --oneline

                    echo "Workspace Files:"
                    ls -lah

                    echo "Kubernetes Files:"
                    find Kubernetes -type f 2>/dev/null || true

                    echo "Checking package.json:"
                    find . -maxdepth 4 -name package.json -type f
                '''
            }
        }

        // --------------------------------------------------
        // 2. BUILD APPLICATION
        // --------------------------------------------------
        stage('Build Application') {
            steps {
                sh '''
                    set -eu

                    echo "===== Node.js Application Build ====="

                    test -f package.json

                    docker run --rm \
                        -v "$WORKSPACE:/app" \
                        -w /app \
                        node:20-alpine \
                        sh -lc '
                            set -eu

                            echo "Node version:"
                            node --version

                            echo "NPM version:"
                            npm --version

                            echo "Installing dependencies:"
                            npm ci

                            echo "Running application build:"
                            npm run build

                            echo "Application build completed."
                        '

                    echo "===== Application Build Successful ====="
                '''
            }
        }

        // --------------------------------------------------
        // 3. BUILD DOCKER IMAGE
        // --------------------------------------------------
        stage('Build Docker Image') {
            steps {
                sh '''
                    set -eu

                    echo "===== Docker Image Build ====="

                    test -f Dockerfile

                    docker build \
                        --pull \
                        -t "$DOCKER_IMAGE:$BUILD_NUMBER" \
                        -t "$DOCKER_IMAGE:latest" \
                        .

                    echo "===== Docker Image Build Successful ====="

                    docker images "$DOCKER_IMAGE"
                '''
            }
        }

        // --------------------------------------------------
        // 4. PUSH IMAGE TO DOCKER HUB
        // --------------------------------------------------
        stage('Push to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-cred',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        echo "===== Docker Hub Login ====="

                        printf '%s' "$DOCKER_PASSWORD" |
                            docker login \
                                --username "$DOCKER_USER" \
                                --password-stdin

                        echo "===== Pushing Docker Images ====="

                        docker push "$DOCKER_IMAGE:$BUILD_NUMBER"

                        docker push "$DOCKER_IMAGE:latest"

                        docker logout

                        echo "===== Docker Hub Push Successful ====="

                        echo "Pushed Images:"
                        echo "$DOCKER_IMAGE:$BUILD_NUMBER"
                        echo "$DOCKER_IMAGE:latest"
                    '''
                }
            }
        }

        // --------------------------------------------------
        // 5. DEPLOY TO KIND KUBERNETES CLUSTER
        // --------------------------------------------------
        stage('Deploy to Kind Kubernetes') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: "${SSH_CREDENTIAL_ID}",
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "===== Kubernetes Deployment Started ====="

                        test -d Kubernetes

                        echo "Checking Kubernetes manifests:"

                        find Kubernetes -type f \\( \
                            -name "*.yaml" -o \
                            -name "*.yml" \
                        \\)

                        REMOTE_DIR="$REMOTE_BASE/$BUILD_NUMBER"

                        echo "===== Preparing Kind Server ====="

                        ssh -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o StrictHostKeyChecking=accept-new \
                            "$SSH_USER@$KIND_SERVER" \
                            "mkdir -p '$REMOTE_DIR'"

                        echo "===== Copying Kubernetes YAML Files ====="

                        scp -r \
                            -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o StrictHostKeyChecking=accept-new \
                            Kubernetes/. \
                            "$SSH_USER@$KIND_SERVER:$REMOTE_DIR/"

                        echo "===== Creating Required Kubernetes Namespace ====="

                        ssh -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o StrictHostKeyChecking=accept-new \
                            "$SSH_USER@$KIND_SERVER" \
                            "kubectl create namespace '$K8S_EXTRA_NAMESPACE' --dry-run=client -o yaml | kubectl apply -f -"

                        echo "===== Verifying Required Namespace ====="

                        ssh -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o StrictHostKeyChecking=accept-new \
                            "$SSH_USER@$KIND_SERVER" \
                            "kubectl get namespace '$K8S_EXTRA_NAMESPACE'"

                        echo "===== Applying Kubernetes Manifests ====="

                        ssh -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o StrictHostKeyChecking=accept-new \
                            "$SSH_USER@$KIND_SERVER" \
                            "kubectl apply -R -f '$REMOTE_DIR'"

                        echo "===== Updating Zomato Application Image ====="

                        ssh -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o StrictHostKeyChecking=accept-new \
                            "$SSH_USER@$KIND_SERVER" \
                            "kubectl set image deployment/$K8S_DEPLOYMENT $K8S_CONTAINER=$DOCKER_IMAGE:$BUILD_NUMBER -n $K8S_NAMESPACE"

                        echo "===== Waiting for Deployment Rollout ====="

                        ssh -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o StrictHostKeyChecking=accept-new \
                            "$SSH_USER@$KIND_SERVER" \
                            "kubectl rollout status deployment/$K8S_DEPLOYMENT -n $K8S_NAMESPACE --timeout=180s"

                        echo "===== Kubernetes Deployment Successful ====="
                    '''
                }
            }
        }

        // --------------------------------------------------
        // 6. VERIFY KUBERNETES DEPLOYMENT
        // --------------------------------------------------
        stage('Verify Deployment') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: "${SSH_CREDENTIAL_ID}",
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "===== Kubernetes Cluster Nodes ====="

                        ssh -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o StrictHostKeyChecking=accept-new \
                            "$SSH_USER@$KIND_SERVER" \
                            "kubectl get nodes"

                        echo "===== Kubernetes Namespaces ====="

                        ssh -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o StrictHostKeyChecking=accept-new \
                            "$SSH_USER@$KIND_SERVER" \
                            "kubectl get namespaces"

                        echo "===== Kubernetes Deployments ====="

                        ssh -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o StrictHostKeyChecking=accept-new \
                            "$SSH_USER@$KIND_SERVER" \
                            "kubectl get deployments -n $K8S_NAMESPACE"

                        echo "===== Kubernetes Pods ====="

                        ssh -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o StrictHostKeyChecking=accept-new \
                            "$SSH_USER@$KIND_SERVER" \
                            "kubectl get pods -n $K8S_NAMESPACE -o wide"

                        echo "===== Node Exporter Namespace Pods ====="

                        ssh -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o StrictHostKeyChecking=accept-new \
                            "$SSH_USER@$KIND_SERVER" \
                            "kubectl get pods -n $K8S_EXTRA_NAMESPACE -o wide"

                        echo "===== Deployed Application Image ====="

                        ssh -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o StrictHostKeyChecking=accept-new \
                            "$SSH_USER@$KIND_SERVER" \
                            "kubectl get deployment $K8S_DEPLOYMENT -n $K8S_NAMESPACE -o jsonpath='{.spec.template.spec.containers[*].image}'"

                        echo ""

                        echo "===== Deployment Verification Completed ====="
                    '''
                }
            }
        }
    }

    post {
        success {
            echo '''
            ==========================================
              PIPELINE COMPLETED SUCCESSFULLY
            ==========================================
              GitHub Checkout
              Application Build
              Docker Image Build
              Docker Hub Push
              Namespace Creation
              Kind Kubernetes Deployment
              Deployment Verification
            ==========================================
            '''
        }

        failure {
            echo '''
            ==========================================
              PIPELINE FAILED
            ==========================================
              Check Jenkins Console Output
            ==========================================
            '''
        }

        always {
            echo 'Jenkins pipeline execution completed.'
        }
    }
}
