pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        GIT_URL = 'https://github.com/cloudvivek/DevOps-Project-Zomato-Kastro.git'
        GIT_BRANCH = 'ai-agent-test'
    }

    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                git branch: "${GIT_BRANCH}", url: "${GIT_URL}"
            }
        }

        stage('Node.js Build') {
            steps {
                sh '''
                    docker run --rm \
                      --user "$(id -u):$(id -g)" \
                      -e HOME=/tmp \
                      -e npm_config_cache=/tmp/npm-cache \
                      -v "$WORKSPACE:/app" \
                      -w /app \
                      node:20-alpine \
                      sh -lc 'set -eu; npm ci; npm run build'
                '''
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build --pull -t ai-agent-test:${BUILD_NUMBER} .'
            }
        }
    }
}
