
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(
            numToKeepStr: '10',
            artifactNumToKeepStr: '5'
        ))
    }

    environment {
        // GitHub
        GIT_URL = 'https://github.com/cloudvivek/DevOps-Project-Zomato-Kastro.git'
        GIT_BRANCH = 'master'

        // Docker Hub
        DOCKER_IMAGE = 'teqvivek123/zomato-kastro'
    }

    stages {

        // --------------------------------------------------
        // 1. CHECKOUT SOURCE CODE
        // --------------------------------------------------
        stage('Checkout') {
            steps {
                deleteDir()

                git branch: "${GIT_BRANCH}",
                    url: "${GIT_URL}"

                sh '''
                    echo "===== GitHub Checkout Successful ====="

                    echo "Repository:"
                    git remote -v

                    echo "Current Branch:"
                    git branch --show-current

                    echo "Latest Commit:"
                    git log -1 --oneline

                    echo "Workspace Files:"
                    ls -lah

                    echo "Checking package.json:"
                    find . -maxdepth 4 -name package.json -type f
                '''
            }
        }

        // --------------------------------------------------
        // 2. BUILD APPLICATION
        // --------------------------------------------------
        stage('Build Application') {
            steps {
                sh '''
                    set -eu

                    echo "===== Node.js Application Build ====="

                    test -f package.json

                    docker run --rm \
                        -v "$WORKSPACE:/app" \
                        -w /app \
                        node:20-alpine \
                        sh -lc '
                            set -eu

                            echo "Node version:"
                            node --version

                            echo "NPM version:"
                            npm --version

                            echo "Installing dependencies:"
                            npm ci

                            echo "Running application build:"
                            npm run build

                            echo "Application build completed."
                        '

                    echo "===== Application Build Successful ====="
                '''
            }
        }

        // --------------------------------------------------
        // 3. BUILD DOCKER IMAGE
        // --------------------------------------------------
        stage('Build Docker Image') {
            steps {
                sh '''
                    set -eu

                    echo "===== Docker Image Build ====="

                    test -f Dockerfile

                    docker build \
                        --pull \
                        -t "$DOCKER_IMAGE:$BUILD_NUMBER" \
                        -t "$DOCKER_IMAGE:latest" \
                        .

                    echo "===== Docker Image Build Successful ====="

                    docker images "$DOCKER_IMAGE"
                '''
            }
        }

        // --------------------------------------------------
        // 4. PUSH IMAGE TO DOCKER HUB
        // --------------------------------------------------
        stage('Push to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-cred',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        echo "===== Docker Hub Login ====="

                        printf '%s' "$DOCKER_PASSWORD" |
                            docker login \
                                --username "$DOCKER_USER" \
                                --password-stdin

                        echo "===== Pushing Docker Images ====="

                        docker push "$DOCKER_IMAGE:$BUILD_NUMBER"

                        docker push "$DOCKER_IMAGE:latest"

                        echo "===== Docker Hub Push Successful ====="

                        echo "Pushed Images:"
                        echo "$DOCKER_IMAGE:$BUILD_NUMBER"
                        echo "$DOCKER_IMAGE:latest"

                        docker logout
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
            echo 'GitHub → Application Build → Docker Build → Docker Hub Push'
        }

        failure {
            echo 'Pipeline failed. Check Jenkins Console Output.'
        }

        always {
            echo 'Jenkins pipeline execution completed.'
        }
    }
}
